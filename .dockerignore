# .dockerignore — Files excluded from the Docker build context
# These files won't be sent to the Docker daemon, keeping builds fast.

# Version control
.git/
.gitignore

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
.cache/
.venv/

# IDE
.idea/
.vscode/
*.swp

# Build artifacts
build/
dist/
out/

# Environment and secrets
.env*
*.pem
*.key
*.crt

# Docs (not needed at runtime)
/docs/
*.md
README*

# Docker files (no need to copy Dockerfile into the image)
Dockerfile*
docker-compose*

# OS files
.DS_Store

# Project-specific: database, cache, scratch
cache.db
scratch/
data/*.csv
data/queries.active
data/wal/

# Project-specific: .DS_Store in subdirectories
static/.DS_Store
static/assets/.DS_Store

# Misc
*.tmp
*.log
